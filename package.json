{
  "name": "book-writing-assistant",
  "displayName": "Book Writing Assistant",
  "description": "A VS Code extension for generating educational content and training materials in markdown format",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "Author-AI-Assistant.createBookStructure",
        "title": "Create Book Structure",
        "category": "Book Writing"
      },
      {
        "command": "Author-AI-Assistant.openChatSidebar",
        "title": "$(comment-discussion) Book Writing Sidebar Chat",
        "category": "Book Writing"
      },
      {
        "command": "Author-AI-Assistant.openBookWritingPanel",
        "title": "$(book) Open Book Writing Assistant Panel (Right Side)",
        "category": "Book Writing"
      }
    ],
    "keybindings": [
      {
        "command": "Author-AI-Assistant.createBookStructure",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "!inDebugMode"
      },
      {
        "command": "Author-AI-Assistant.openChatSidebar",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "Author-AI-Assistant.openBookWritingPanel",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bookWriting",
          "title": "Book Writing Assistant",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "bookWriting": [
        {
          "id": "bookWritingConfig",
          "name": "AI Model Configuration",
          "type": "webview",
          "icon": "$(settings-gear)"
        }
      ]
    },
    "configuration": {
      "title": "Book Writing Assistant",
      "properties": {
        "bookWritingAssistant.aiProvider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "anthropic", "google", "local"],
          "description": "AI provider to use for content generation"
        },
        "bookWritingAssistant.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the selected AI provider"
        },
        "bookWritingAssistant.model": {
          "type": "string",
          "default": "gpt-3.5-turbo",
          "description": "Model name to use for content generation"
        },
        "bookWritingAssistant.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.0,
          "maximum": 2.0,
          "description": "Controls randomness in AI responses (0.0 = deterministic, 2.0 = very creative)"
        },
        "bookWritingAssistant.maxTokens": {
          "type": "integer",
          "default": 2000,
          "minimum": 100,
          "maximum": 8000,
          "description": "Maximum number of tokens in generated content"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.102.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "ts-loader": "^9.5.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
